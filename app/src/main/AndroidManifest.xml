<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DateCalculator"
        tools:targetApi="34">
        <activity
            android:name="me.paco.datecalculator.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DateCalculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件 (AppWidgets) 注册 -->
        <receiver
            android:name="me.paco.datecalculator.widget.CountdownWidgetProvider"
            android:exported="true"
            android:label="倒数日桌面小组件">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>

        <receiver
            android:name="me.paco.datecalculator.widget.AlmanacWidgetProvider"
            android:exported="true"
            android:label="今日黄历桌面小组件">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_almanac_info" />
        </receiver>

        <receiver
            android:name="me.paco.datecalculator.widget.AnniversaryWidgetProvider"
            android:exported="true"
            android:label="重要纪念日桌面小组件">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_anniversary_info" />
        </receiver>

        <receiver
            android:name="me.paco.datecalculator.widget.CheckInWidgetProvider"
            android:exported="true"
            android:label="纪念日打卡桌面小组件">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_checkin_info" />
        </receiver>

        <receiver
            android:name="me.paco.datecalculator.widget.QuickCalcWidgetProvider"
            android:exported="true"
            android:label="日期快速计算桌面小组件">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_calc_info" />
        </receiver>
    </application>

</manifest>
