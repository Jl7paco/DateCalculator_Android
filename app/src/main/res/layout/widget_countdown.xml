<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_neumorphic"
    android:padding="14dp"
    android:gravity="center">

    <!-- 顶部 3D 标头行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏳ 目标倒数日"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2563EB" />

        <TextView
            android:id="@+id/btn_next_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="切换 ➔"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:background="@drawable/widget_chip_sunken"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_event_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🇨🇳 国庆节"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginTop="8dp" />

    <!-- 3D 凹槽巨幕倒数天数数字卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_card_inset"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9 天"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#2563EB" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_date_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="目标: 2026-10-01"
        android:textSize="11sp"
        android:textColor="#64748B"
        android:layout_marginTop="6dp" />
</LinearLayout>
