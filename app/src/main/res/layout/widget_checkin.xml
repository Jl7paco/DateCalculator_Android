<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_neumorphic"
    android:padding="12dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_checkin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 纪念日打卡"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#EC4899" />

    <TextView
        android:id="@+id/widget_checkin_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 当前位置: 深圳市"
        android:textSize="11.5sp"
        android:textColor="#1E293B"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/widget_checkin_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 1键打卡"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/widget_btn_neumorphic_pink"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="6dp" />
</LinearLayout>
