<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_neumorphic"
    android:padding="14dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_anniversary_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="❤️ 重要纪念日"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#EC4899" />

    <TextView
        android:id="@+id/widget_anniversary_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💍 结婚纪念日"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_card_inset"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_anniversary_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1314 天"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#EC4899" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_anniversary_base"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="起始: 2022-01-01"
        android:textSize="11sp"
        android:textColor="#64748B"
        android:layout_marginTop="6dp" />
</LinearLayout>
