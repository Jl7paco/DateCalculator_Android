<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_neumorphic"
    android:padding="12dp">

    <!-- Header: Date and Month -->
    <TextView
        android:id="@+id/tv_month_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2026年 10月"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2563EB"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Calendar Grid -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_inset"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="日" android:textSize="10sp" android:textColor="#EF4444" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="一" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="二" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="三" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="四" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="五" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="六" android:textSize="10sp" android:textColor="#EF4444" android:gravity="center" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/cell_day_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/cell_day_7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_10" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_11" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_12" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_13" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/cell_day_14" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_15" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_16" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_17" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_18" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_19" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_20" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/cell_day_21" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_22" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_23" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_24" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_25" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_26" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_27" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/cell_day_28" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_29" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_30" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_31" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_32" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_33" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_34" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/cell_day_35" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_36" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_37" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_38" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_39" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_40" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:id="@+id/cell_day_41" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- Right Panels (Almanac, Fortune, Weather) -->
        <LinearLayout
            android:id="@+id/panel_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_almanac"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView android:text="📜 今日黄历" android:textSize="11sp" android:textColor="#047857" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tv_lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1E293B" android:textStyle="bold" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/tv_yiji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textColor="#64748B" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_fortune"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView android:text="✨ 运势" android:textSize="11sp" android:textColor="#9333EA" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tv_fortune_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1E293B" android:textStyle="bold" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/tv_fortune_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textColor="#64748B" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_weather"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView android:text="☀️ 天气" android:textSize="11sp" android:textColor="#2563EB" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tv_weather_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#1E293B" android:textStyle="bold" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/tv_weather_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textColor="#64748B" android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
