            <TextView android:id="@+id/dash_cell_25" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_26" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_27" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/dash_cell_28" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_29" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_30" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_31" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_32" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_33" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_34" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/dash_cell_35" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_36" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_37" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_38" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_39" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_40" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_41" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部置顶倒数日/纪念日看板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tv_dash_event_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌 考研倒计时"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#EC4899" />

        <TextView
            android:id="@+id/tv_dash_event_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="还有 72 天 (2026年12月22日)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:background="@drawable/widget_chip_sunken"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
