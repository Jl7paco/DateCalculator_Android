        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/dash_cell_7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
