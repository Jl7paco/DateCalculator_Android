        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/dash_cell_14" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_15" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_16" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_17" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_18" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_19" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_20" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/dash_cell_21" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_22" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
