<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_neumorphic"
    android:padding="12dp">

    <!-- 顶部 3D 标头行 (日期 + 天气 + 宜忌) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_dash_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026年 10月"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2563EB" />

        <TextView
            android:id="@+id/tv_dash_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️ 25°C 深圳市"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />
    </LinearLayout>

    <!-- 中间月历网格 (6 行 x 7 列) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_inset"
        android:padding="6dp"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="日" android:textSize="10sp" android:textColor="#EF4444" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="一" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="二" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="三" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="四" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="五" android:textSize="10sp" android:textColor="#64748B" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="六" android:textSize="10sp" android:textColor="#EF4444" android:gravity="center" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/dash_cell_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:id="@+id/dash_cell_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="10.5sp" android:textStyle="bold" android:gravity="center" />
